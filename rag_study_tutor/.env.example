# Copy this file to ".env" and edit it. Never commit .env to GitHub.

# auto | none | gemini | groq | ollama
RAG_LLM_PROVIDER=auto

# Google AI Studio -> https://aistudio.google.com/apikey  (free tier)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Groq -> https://console.groq.com/keys  (free tier)
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Ollama running locally -> https://ollama.com
OLLAMA_MODEL=llama3.2
OLLAMA_HOST=http://localhost:11434

# auto | hashing | sentence-transformers
RAG_EMBEDDER=auto

# Retrieval settings
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=150
RAG_TOP_K=4
